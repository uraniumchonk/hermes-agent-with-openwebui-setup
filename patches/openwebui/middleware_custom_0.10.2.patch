+def _message_inject_key(message: dict, cached_path: str) -> str:
+    """Stable key for one (message, image path) pair."""
+    msg_id = message.get('id') or message.get('message_id') or ''
+    if not msg_id:
+        urls: list[str] = []
+        content = message.get('content')
+        if isinstance(content, list):
+            for item in content:
+                if isinstance(item, dict) and item.get('type') == 'image_url':
+                    url = (item.get('image_url') or {}).get('url', '')
+                    # data: URLs are huge; fingerprint prefix + length
+                    if isinstance(url, str) and url.startswith('data:'):
+                        urls.append(f'data:{len(url)}:{url[:64]}')
+                    else:
+                        urls.append(str(url)[:240])
+        msg_id = hashlib.md5('|'.join(urls).encode('utf-8', errors='replace')).hexdigest()
+    return hashlib.md5(f'{msg_id}|{cached_path}'.encode('utf-8', errors='replace')).hexdigest()
+
+
+def _get_or_create_inject_ts(message: dict, cached_path: str) -> str:
+    """First stamp wins for this message+path; later requests reuse it."""
+    key = _message_inject_key(message, str(cached_path))
+    if key in _IMAGE_INJECT_TS_MEM:
+        return _IMAGE_INJECT_TS_MEM[key]
+    ts_path = _IMAGE_INJECT_TS_DIR / f'{key}.txt'
+    try:
+        if ts_path.exists():
+            ts = ts_path.read_text(encoding='utf-8').strip()
+            if ts:
+                _IMAGE_INJECT_TS_MEM[key] = ts
+                return ts
+    except Exception as e:
+        log.debug(f'read inject ts failed: {e}')
+    ts = datetime.now().strftime('%Y-%m-%dT%H:%M:%S')
+    _IMAGE_INJECT_TS_MEM[key] = ts
+    try:
+        ts_path.write_text(ts, encoding='utf-8')
+    except Exception as e:
+        log.debug(f'write inject ts failed: {e}')
+    return ts
+
