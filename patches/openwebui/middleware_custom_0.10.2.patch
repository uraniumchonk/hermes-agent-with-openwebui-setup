+async def inject_image_file_paths(form_data, user=None):
+    """把 image_url parts 替換為本地檔案路徑文字。
+
+    策略：
+    - **僅**「當下最後一則 user message」中的圖片：注入 path + 固定 timestamp
+    - 有 file_id → **優先 OWUI uploads/**（DB file.path，單一真相來源）
+    - data:image/ base64 → 才寫入 image_cache/（uploads 沒有的 ephemeral）
+    - 歷史 user message：穩定 placeholder，**永不 restamp**
+
+    重要（prefix cache）：
+    - 禁止用「最後一則含圖訊息」當 is_latest
+    - timestamp 只允許出現在「當下最後一則 user message」，且同一 message+path 首次固定
+
+    注意：image_url → text，避免 convert_url_images_to_base64 再塞 base64。
+    """
+    messages = form_data.get('messages', [])
+    if not messages:
+        return form_data
+
+    # 當下最新 user 訊息索引（不是「最後一則含圖」）
+    latest_user_msg_idx = None
+    for i in range(len(messages) - 1, -1, -1):
+        if messages[i].get('role') == 'user':
+            latest_user_msg_idx = i
+            break
+
+    for msg_idx, message in enumerate(messages):
+        content = message.get('content')
+        if not isinstance(content, list):
+            continue
+
+        image_parts = [
+            item for item in content
+            if isinstance(item, dict) and item.get('type') == 'image_url'
+        ]
+        if not image_parts:
+            continue
+
+        is_current_user_turn = (msg_idx == latest_user_msg_idx)
+        num_images = len(image_parts)
+
+        new_content = []
+        image_counter = 0
+
+        text_parts = [item for item in content if isinstance(item, dict) and item.get('type') == 'text']
+        has_text = len(text_parts) > 0
+
+        for item in content:
+            if not isinstance(item, dict) or item.get('type') != 'image_url':
+                if isinstance(item, dict):
+                    new_content.append(dict(item))
+                else:
+                    new_content.append(item)
+                continue
+
+            image_counter += 1
+
+            if is_current_user_turn:
+                url_val = item.get('image_url', {}).get('url', '')
+                local_path = None
+                source_kind = None
+
+                if isinstance(url_val, str) and url_val.startswith('data:image/'):
+                    # Ephemeral base64 only — uploads has no row for this blob
+                    try:
+                        header, b64_data = url_val.split(',', 1)
+                        mime_part = header.split(';')[0].split(':')[1]
+                        ext_map_rev = {
+                            'image/png': '.png', 'image/jpeg': '.jpg', 'image/jpg': '.jpg',
+                            'image/webp': '.webp', 'image/gif': '.gif',
+                        }
+                        ext = ext_map_rev.get(mime_part, '.jpg')
+                        import base64 as b64mod
+                        cache_name = f"data_{hashlib.md5(b64_data.encode()).hexdigest()}{ext}"
+                        cache_path = IMAGE_CACHE_DIR / cache_name
+                        if not cache_path.exists():
+                            with open(cache_path, 'wb') as f:
+                                f.write(b64mod.b64decode(b64_data))
+                        local_path = str(cache_path)
+                        source_kind = 'image_cache'
+                        log.debug(f'Ephemeral base64 image -> {local_path}')
+                    except Exception as e:
+                        log.debug(f'Error caching base64 image: {e}')
+                        new_content.append(item)
+                        continue
+                else:
+                    file_id = _extract_file_id_from_url(str(url_val or ''))
+                    if file_id:
+                        # Prefer uploads via DB path — do NOT dual-write image_cache
+                        local_path = await _resolve_document_local_path(
+                            {'id': file_id, 'url': file_id, 'type': 'image'},
+                            user=user,
+                        )
+                        if local_path:
+                            source_kind = 'uploads'
+                            log.debug(f'Image {file_id} -> {local_path} ({source_kind})')
+                        else:
+                            new_content.append(item)
+                            continue
+                    else:
+                        # Unknown URL shape — leave for convert_url_images_to_base64
+                        new_content.append(item)
+                        continue
+
+                try:
+                    file_size = os.path.getsize(local_path)
+                    file_ext = Path(local_path).suffix.lower()
+                    if file_size < 1024:
+                        size_str = f'{file_size}B'
+                    elif file_size < 1024 * 1024:
+                        size_str = f'{file_size / 1024:.1f}KB'
+                    else:
+                        size_str = f'{file_size / (1024 * 1024):.1f}MB'
+                except Exception:
+                    size_str = 'unknown'
+                    file_ext = Path(local_path).suffix.lower() if local_path else ''
+
+                image_filename = Path(local_path).name
+                # Pi cold-backup mirror (uploads + ephemeral cache). 9098 may serve basename.
+                remote_url = f'http://192.168.0.150:9098/file/{image_filename}'
+                ts = _get_or_create_inject_ts(message, str(local_path))
+
+                if num_images == 1:
+                    image_desc = (
+                        f'\n\n---\n'
+                        f'📎 Image: {local_path} ({file_ext}, {size_str})\n'
+                        f'🔹 Local: call vision_analyze(path="{local_path}")\n'
+                        f'🔹 Remote: if you cannot access local path, download from {remote_url} then analyze it.\n'
+                        f'⚠️ IMPORTANT: Prepend this timestamp to the "question" field: "[{ts}] " to ensure KV cache uniqueness.\n'
+                        f'---\n\n'
+                    )
+                else:
+                    image_desc = (
+                        f'\n\n---\n'
+                        f'📎 Image {image_counter}/{num_images}: {local_path} ({file_ext}, {size_str})\n'
+                        f'🔹 Local: call vision_analyze(path="{local_path}")\n'
+                        f'🔹 Remote: if you cannot access local path, download from {remote_url} then analyze it.\n'
+                        f'⚠️ IMPORTANT: Prepend this timestamp to the "question" field: "[{ts}] " to ensure KV cache uniqueness.\n'
+                        f'---\n\n'
+                    )
+
+                if not has_text and image_counter == 1:
+                    image_desc = '[No text — use vision_analyze to view attached image]\n\n' + image_desc
+
+                new_content.append({'type': 'text', 'text': image_desc})
+            else:
+                # 歷史訊息：穩定 placeholder
+                new_content.append({
+                    'type': 'text',
+                    'text': f'[Image: {num_images} image(s) attached]',
+                })
+
+        message['content'] = new_content
+
+    return form_data
+
