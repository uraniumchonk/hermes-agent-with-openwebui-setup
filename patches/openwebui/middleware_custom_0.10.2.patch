+async def cache_file_from_file_id(file_id: str, user=None, is_image=False) -> str | None:
+    """從 Open WebUI file store 複製檔案到本地快取，回傳絕對路徑。
+    
+    Args:
+        file_id: Open WebUI 檔案的 UUID
+        user: 當前用戶（用於權限檢查）
+        is_image: 是否為圖片（決定快取目錄）
+    
+    Returns:
+        快取後的絕對路徑，失敗時返回 None
+    """
+    try:
+        file_info = await Files.get_file_by_id(file_id)
+        if not file_info:
+            log.debug(f'File not found in DB: {file_id}')
+            return None
+        
+        # 檢查擁有者
+        if user and file_info.user_id:
+            if hasattr(user, 'id') and file_info.user_id != user.id:
+                # 也允許 admin
+                if not hasattr(user, 'role') or user.role != 'admin':
+                    log.debug(f'File {file_id} belongs to different user')
+                    return None
+        
+        # 取得來源路徑
+        source_path = getattr(file_info, 'path', None)
+        if not source_path:
+            log.debug(f'File {file_id} has no path')
+            return None
+        
+        # 使用 Storage provider 取得實際檔案路徑
+        try:
+            from open_webui.storage.provider import Storage
+            import asyncio
+            source_path = await asyncio.to_thread(Storage.get_file, source_path)
+        except Exception:
+            pass  # 如果 Storage.get_file 失敗，直接用原始 path
+        
+        if not source_path or not os.path.exists(source_path):
+            log.debug(f'File source not found: {source_path}')
+            return None
+        
+        # 決定副檔名
+        ext = '.bin'
+        meta = getattr(file_info, 'meta', None)
+        if isinstance(meta, dict) and meta.get('content_type'):
+            ext = _get_ext_from_content_type(meta['content_type'])
+        elif getattr(file_info, 'filename', None):
+            _, e = os.path.splitext(file_info.filename)
+            if e:
+                ext = e
+        
+        # 選擇快取目錄
+        cache_dir = IMAGE_CACHE_DIR if is_image else FILE_CACHE_DIR
+        
+        # 複製到快取
+        cached_path = cache_dir / f"{file_id}{ext}"
+        shutil.copy2(source_path, str(cached_path))
+        log.debug(f'Cached file {file_id} -> {cached_path}')
+        return str(cached_path)
+    except Exception as e:
+        log.debug(f'Error caching file from file_id {file_id}: {e}')
+        return None
+
