+# --- File cache + path injection for Hermes agent ---
+# Supports: images (vision_analyze) + documents (read_file)
+IMAGE_CACHE_DIR = Path('/home/user/openwebui/data/image_cache')
+IMAGE_CACHE_DIR.mkdir(parents=True, exist_ok=True)
