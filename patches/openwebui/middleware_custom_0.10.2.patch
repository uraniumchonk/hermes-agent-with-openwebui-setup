+def _is_image_file_item(file: dict) -> bool:
+    if not isinstance(file, dict):
+        return False
+    return file.get('type') == 'image' or str(file.get('content_type') or '').startswith('image/')
+
+
+def _collect_request_file_items(form_data: dict) -> list[dict]:
+    """Gather attachment dicts from every place Open WebUI may stash them."""
+    items: list[dict] = []
+    metadata = form_data.get('metadata') or {}
+    for src in (
+        metadata.get('files'),
+        form_data.get('files'),
+    ):
+        if isinstance(src, list):
+            items.extend([f for f in src if isinstance(f, dict)])
+
+    for message in form_data.get('messages') or []:
+        if not isinstance(message, dict):
+            continue
+        msg_files = message.get('files')
+        if isinstance(msg_files, list):
+            items.extend([f for f in msg_files if isinstance(f, dict)])
+        for aid in message.get('attachment_ids') or []:
+            if isinstance(aid, str) and aid:
+                items.append({'id': aid, 'type': 'file', 'url': aid})
+
+    # Dedupe by file id / url
+    seen: set[str] = set()
+    unique: list[dict] = []
+    for f in items:
+        key = str(f.get('id') or f.get('url') or f.get('path') or id(f))
+        if key in seen:
+            continue
+        seen.add(key)
+        unique.append(f)
+    return unique
+
