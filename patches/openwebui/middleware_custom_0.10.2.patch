+# 同一則「當下」user message 的 timestamp 必須跨 agent multi-step / 重試 固定。
+# 禁止每次 request 都 datetime.now() 重戳，否則會打穿 vLLM/LMCache prefix cache。
+_IMAGE_INJECT_TS_DIR = IMAGE_CACHE_DIR / '.inject_ts'
+_IMAGE_INJECT_TS_DIR.mkdir(parents=True, exist_ok=True)
+_IMAGE_INJECT_TS_MEM: dict[str, str] = {}
