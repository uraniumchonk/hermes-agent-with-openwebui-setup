+async def inject_document_file_paths(form_data, user=None):
+    """Intercept non-image attachments and inject local path text for Hermes.
+
+    Sources (Open WebUI 0.10.x scatters these):
+      - form_data['metadata']['files']  (set late in process_chat_payload)
+      - form_data['files']
+      - messages[*].files / attachment_ids
+
+    Strategy:
+      - Prefer the existing uploads/ path from the file DB (no mandatory cache copy)
+      - Inject path + read_file instructions into the latest user message
+      - Strip non-image entries from metadata/form files so native RAG does not
+        re-inject extracted text and bloat the prompt
+    """
+    all_files = _collect_request_file_items(form_data)
+    if not all_files:
+        return form_data
+
+    doc_files = [f for f in all_files if not _is_image_file_item(f)]
+    if not doc_files:
+        return form_data
+
+    # Strip non-image files from metadata / form_data so RAG won't re-process them
+    metadata = form_data.get('metadata')
+    if isinstance(metadata, dict):
+        meta_files = metadata.get('files')
+        if isinstance(meta_files, list):
+            metadata['files'] = [f for f in meta_files if isinstance(f, dict) and _is_image_file_item(f)]
+            form_data['metadata'] = metadata
+
+    top_files = form_data.get('files')
+    if isinstance(top_files, list):
+        form_data['files'] = [f for f in top_files if isinstance(f, dict) and _is_image_file_item(f)]
+
+    messages = form_data.get('messages', [])
+    if not messages:
+        return form_data
+
+    latest_user_msg = None
+    for msg in reversed(messages):
+        if isinstance(msg, dict) and msg.get('role') == 'user':
+            latest_user_msg = msg
+            break
+    if not latest_user_msg:
+        return form_data
+
+    # Also strip files off messages (keep images only if any remain)
+    for msg in messages:
+        if not isinstance(msg, dict) or not isinstance(msg.get('files'), list):
+            continue
+        kept = [f for f in msg['files'] if isinstance(f, dict) and _is_image_file_item(f)]
+        if kept:
+            msg['files'] = kept
+        else:
+            msg.pop('files', None)
+
+    file_descriptions: list[str] = []
+    resolved_paths: list[str] = []
+    for file_idx, file in enumerate(doc_files, 1):
+        filename = file.get('name') or file.get('filename') or f'file_{file_idx}'
+        local_path = await _resolve_document_local_path(file, user=user)
+        if not local_path:
+            log.info(f'inject_document: skip unresolved file name={filename} id={file.get("id")}')
+            continue
+
+        try:
+            file_size = os.path.getsize(local_path)
+            file_ext = Path(local_path).suffix.lower()
+            if file_size < 1024:
+                size_str = f'{file_size}B'
+            elif file_size < 1024 * 1024:
+                size_str = f'{file_size / 1024:.1f}KB'
+            else:
+                size_str = f'{file_size / (1024 * 1024):.1f}MB'
+        except Exception:
+            size_str = 'unknown'
+            file_ext = Path(local_path).suffix.lower()
+
+        # Keep remote hint for agents not on meowhome; primary is local path.
+        remote_url = f'http://192.168.0.150:9098/file/{Path(local_path).name}'
+        if len(doc_files) == 1:
+            file_desc = (
+                f'\n\n---\n'
