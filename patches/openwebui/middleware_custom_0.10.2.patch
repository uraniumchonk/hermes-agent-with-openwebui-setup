+def _extract_file_id_from_url(url: str) -> str | None:
+    """從 Open WebUI 檔案 URL 中提取 file_id。
+    
+    URL 格式可能為:
+    - http://localhost:8080/api/v1/uploads/file_id/filename.jpg
+    - /api/v1/uploads/file_id/filename.jpg
+    - http://localhost:8080/files/file_id/view
+    - /files/file_id/view
+    """
+    # Pattern 1: /uploads/{file_id}/...
+    m = re.search(r'/uploads/([a-f0-9-]+)/', url)
+    if m:
+        return m.group(1)
+    
+    # Pattern 2: /files/{file_id}/...
+    m = re.search(r'/files/([a-f0-9-]+)/', url)
+    if m:
+        return m.group(1)
+    
+    # Pattern 3: 直接是 UUID（有時 URL 就是 file_id 本身）
+    m = re.search(r'[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}', url)
+    if m:
+        return m.group(0)
+    
+    return None
+
+
+def _get_ext_from_content_type(content_type: str) -> str:
+    """從 content_type 推導副檔名。"""
+    ext_map = {
+        # Images
+        'image/png': '.png', 'image/jpeg': '.jpg', 'image/jpg': '.jpg',
+        'image/webp': '.webp', 'image/gif': '.gif', 'image/bmp': '.bmp',
+        'image/svg+xml': '.svg',
+        # Documents
+        'application/pdf': '.pdf',
+        'application/vnd.openxmlformats-officedocument.wordprocessingml.document': '.docx',
+        'application/msword': '.doc',
+        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': '.xlsx',
+        'application/vnd.ms-excel': '.xls',
+        'application/vnd.openxmlformats-officedocument.presentationml.presentation': '.pptx',
+        'application/vnd.ms-powerpoint': '.ppt',
+        # Text
+        'text/plain': '.txt', 'text/csv': '.csv', 'text/html': '.html',
+        'text/markdown': '.md', 'application/json': '.json',
+        'text/xml': '.xml', 'application/xml': '.xml',
+        # Code
+        'text/javascript': '.js', 'text/css': '.css',
+        'application/x-python-code': '.py',
+    }
+    return ext_map.get(content_type, '.bin')
+
