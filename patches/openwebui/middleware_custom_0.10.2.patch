+async def _resolve_document_local_path(file: dict, user=None) -> str | None:
+    """Resolve a readable on-disk path for a non-image attachment.
+
+    Prefer the server upload path already stored in DB (no extra cache copy).
+    Fall back to cache_file_from_file_id only if the primary path is missing.
+    """
+    # Direct path on the item (rare but cheap)
+    direct = file.get('path')
+    if isinstance(direct, str) and direct and os.path.exists(direct):
+        return direct
+
+    url = str(file.get('url') or '')
+    file_id = file.get('id') or (_extract_file_id_from_url(url) if url and not url.startswith('data:') else None)
+    if not file_id:
+        return None
+
+    try:
+        file_info = await Files.get_file_by_id(file_id)
+        if not file_info:
+            log.info(f'inject_document: file not in DB id={file_id}')
+            return None
+
+        if user and file_info.user_id and hasattr(user, 'id') and file_info.user_id != user.id:
+            if not hasattr(user, 'role') or user.role != 'admin':
+                log.info(f'inject_document: permission denied id={file_id}')
+                return None
+
+        source_path = getattr(file_info, 'path', None)
+        if source_path:
+            try:
+                from open_webui.storage.provider import Storage
+                import asyncio
+
+                source_path = await asyncio.to_thread(Storage.get_file, source_path)
+            except Exception:
+                pass
+
+        if source_path and os.path.exists(source_path):
+            return str(source_path)
+
+        # Fallback: optional copy into file_cache (legacy behaviour)
+        return await cache_file_from_file_id(file_id, user=user, is_image=False)
+    except Exception as e:
+        log.info(f'inject_document: resolve failed id={file_id}: {e}')
+        return None
+
